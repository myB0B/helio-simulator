# Cle publique CARTO utilisee par les tuiles affichees dans le navigateur.
# Restreindre cette cle aux domaines autorises dans la console CARTO.
VITE_CARTO_API_KEY=

# Deploiement distant. Utiliser ftps (port 21) ou sftp (port 22).
DEPLOY_PROTOCOL=ftps
DEPLOY_HOST=
DEPLOY_PORT=21
DEPLOY_USERNAME=
DEPLOY_PASSWORD=
DEPLOY_REMOTE_PATH=/heliosim/

# Métadonnées du dépôt GitHub. GitHub CLI stocke son authentification séparément.
GITHUB_OWNER=
GITHUB_REPOSITORY=helio-simulator
GITHUB_VISIBILITY=public
GITHUB_REPOSITORY_URL=
